#!/bin/sh
# Runs as root once Installer has put the app in /Applications. Starts it
# again for whoever is logged in — the in-app updater quit it to let the new
# version in — unless this is an unattended `installer -pkg` from a
# terminal, where nobody asked for a window.
[ -n "$COMMAND_LINE_INSTALL" ] && exit 0

user=$(stat -f %Su /dev/console 2>/dev/null)
[ -z "$user" ] || [ "$user" = "root" ] || [ "$user" = "loginwindow" ] && exit 0
uid=$(id -u "$user") || exit 0

app="$2/Random Wallpaper.app"
[ -d "$app" ] || app="/Applications/Random Wallpaper.app"
# Anything downloaded by a browser carries a quarantine flag that would put
# a Gatekeeper prompt in front of every start; Installer already vouched.
xattr -dr com.apple.quarantine "$app" 2>/dev/null
launchctl asuser "$uid" sudo -u "$user" open "$app" >/dev/null 2>&1 &
exit 0
